# Database Configuration
DATABASE_URL='postgresql://postgres:password@localhost:5432/apple_game'

# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini # 또는 인프라 아키텍처에 정의된 배포 모델명
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Search 설정
AZURE_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_KEY="your_azure_search_admin_key_here"
AZURE_SEARCH_INDEX_NAME="game-policy-index"

# Azure AI Speech Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=koreacentral

# App Configuration
PORT=8000
HOST=0.0.0.0
