# Database Configuration
DATABASE_URL='postgresql://postgres:postgrespassword@172.16.30.143:5432/apple_game'

# Azure OpenAI Configuration
AZURE_OPENAI_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini # 또는 인프라 아키텍처에 정의된 gpt-5-mini(현실적으로는 4o-mini 등 사용)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure AI Search 설정 (team3search 리소스)
AZURE_SEARCH_ENDPOINT="https://team3search.search.windows.net"
AZURE_SEARCH_KEY="AI_Search_관리자_키_입력"
AZURE_SEARCH_INDEX_NAME="team3index"

# Azure AI Speech Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=koreacentral

# App Configuration
PORT=8000
HOST=0.0.0.0
